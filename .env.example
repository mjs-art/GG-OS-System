# =============================================================================
# Studio OS — contrato de configuración
#
# Copia este archivo a .env.local y llena los valores.
# .env* está en .gitignore. NUNCA commitees el archivo lleno.
# Cada variable que agregues aquí tiene que quedar validada en src/lib/env.ts,
# o la app no arranca.
# =============================================================================

# --- Público (llega al navegador) -------------------------------------------
# Todo lo que lleva NEXT_PUBLIC_ es visible para cualquiera que abra la app.
# Si un valor no puede ser público, no lleva ese prefijo. Sin excepciones.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Llave anónima. Es pública por diseño: la seguridad la da RLS, no esta llave.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# --- Servidor (nunca sale del servidor) --------------------------------------

# service_role hace bypass de TODO el RLS. Solo se usa en jobs de agentes y
# migraciones de datos, jamás en un route handler que responda a un usuario.
# Si un archivo bajo src/app/ la importa, es un bug de seguridad.
SUPABASE_SERVICE_ROLE_KEY=

# Se usa para firmar los tokens de invitación del portal de cliente.
# Genera uno con: openssl rand -base64 48
CLIENT_PORTAL_TOKEN_SECRET=

# --- Agentes (fase 2 — todavía no se usan) -----------------------------------
# Con AGENTS_PROVIDER=mock la app no hace ni una llamada de red a un LLM.
AGENTS_PROVIDER=mock
ANTHROPIC_API_KEY=
# Tope duro de gasto mensual en dólares. Al llegar, los agentes se apagan.
AGENTS_MONTHLY_BUDGET_USD=50

# --- APIs de redes (fase "Después" — sin configurar, la app usa manual/CSV) --
# La app funciona completa sin estas variables. Cuando los trámites de
# verificación de negocio estén listos y Meta haya aprobado la app, se llenan
# aquí y el sync de métricas se activa en el dashboard.
META_APP_ID=
META_APP_SECRET=
# Token de Instagram de largo plazo. Se obtiene llamando refrescarTokenInstagram.
INSTAGRAM_LONG_LIVED_TOKEN=
# Token de Meta Ads con scope ads_read. Lectura sí, escritura nunca.
META_ADS_TOKEN=
# ID de la cuenta publicitaria sin el prefijo act_ (ej: 123456789).
META_ADS_ACCOUNT_ID=
# Token de Apify. Sin verificación de Meta: usa scrapers ya integrados.
# https://console.apify.com/settings/integrations
APIFY_API_TOKEN=

# --- WhatsApp vía n8n — n8n tiene las credenciales de Meta; aquí solo el puente.
# Regla #4: los tokens de Meta viven en n8n, no en el repo.
# Secreto compartido: n8n lo manda en cada llamada entrante y la app en cada
# envío. Sin él, la ruta /api/jobs/whatsapp rechaza todo.
N8N_INBOUND_SECRET=
# URL del webhook de n8n que envía un saliente ya aprobado por WhatsApp.
N8N_SEND_WEBHOOK_URL=

# --- Agente Investigador — resumen de video de YouTube.
# Webhook de n8n que recibe la URL del video y responde con la transcripción
# en la misma llamada. Sin ella, el agente Investigador no puede correr.
N8N_INVESTIGADOR_WEBHOOK_URL=
